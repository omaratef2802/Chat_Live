# ==========================================
# Chat Live - Backend environment variables
# Copy this file to .env and replace placeholders.
# Never commit your real .env file or secrets.
# ==========================================

# Server (currently used)
NODE_ENV=development
PORT=3000

# MongoDB (currently used)
# Local development example:
MONGODB_URI=mongodb://127.0.0.1:27017/chat_live
# Or use your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/chat_live

# JWT authentication (for the authentication services)
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_EXPIRES_IN=15m

# Refresh tokens / linked devices (for the planned session implementation)
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Email OTP and password reset - Nodemailer SMTP
# Gmail example: host=smtp.gmail.com, port=587, secure=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Chat Live <your_email@gmail.com>

# Media uploads - Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL / CORS (used when these integrations are wired)
CLIENT_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
